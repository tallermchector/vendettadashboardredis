# ----------------------------------------------------
# Vendetta - Git Ignore Configuration
# ----------------------------------------------------

# Dependencias
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Compilación y Salida de Next.js
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# Variables de Entorno y Secretos (nunca subir claves ni credenciales)
.env
.env*.local
.env.development
.env.production
.env.test
!.env.example

# Logs y Depuración
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*

# Cobertura de Pruebas
/coverage
/.nyc_output

# Plataformas en la Nube y Caches de Despliegue
.vercel
/.idx/
.genkit/*

# Archivos del Sistema Operativo e IDEs
.DS_Store
Thumbs.db
*.pem
*.key
*.cert
.idea/
*.sublime-project
*.sublime-workspace

# Artefactos y Bases de Datos Locales
*.sqlite
*.sqlite3
*.db
/src/generated/prisma
# Salida de `contract emit` de Prisma 8 (ver prisma8.config.ts -> output).
# Artefactos regenerables: se versionan solo `prisma8/*.prisma`.
/generated/prisma8
/vendetta/
/vendetta

# ----------------------------------------------------
# Marcadores y archivos generados para IAs
# ----------------------------------------------------
# Archivo marcador vacío, sin uso
.modified

# Los ignore files de IA se GENERAN desde .aiexclude con `pnpm ai:excludes`.
# No editar a mano. .aiexclude sí se versiona: es la fuente canónica.
/.claudeignore
/.cursorignore
/.geminiignore
