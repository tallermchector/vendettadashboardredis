# .aiexclude — FUENTE CANÓNICA del filtro de contexto para IA
#
# ⚠️  EDITA SOLO ESTE ARCHIVO. Las copias .claudeignore / .cursorignore / .geminiignore
#     se generan desde aquí con `pnpm ai:excludes` y se sobrescriben.
#     Verifica que no haya drift con `pnpm ai:excludes:check`.
#     Las copias se normalizan a LF; el canónico puede estar en CRLF según tu checkout.
#
# Reduce drásticamente el consumo de tokens: omite binarios, volcados pesados,
# artefactos de compilación y librerías de terceros que no son código del proyecto.
#
# .gitignore es un archivo DISTINTO y complementario: protege el repositorio, no el
# contexto. Un artefacto de build no siempre es una exclusión de lectura — p. ej.
# public/*.svg se sirve en producción pero no se lee como texto.

# ----------------------------------------------------
# 1. Dependencias y Entornos de Ejecución
# ----------------------------------------------------
node_modules/
.pnp/
.pnp.*
.yarn/
vendor/

# ----------------------------------------------------
# 2. Artefactos de Compilación y Cache
# ----------------------------------------------------
.next/
out/
build/
dist/
.turbo/
.cache/
.vercel/
*.tsbuildinfo
next-env.d.ts

# ----------------------------------------------------
# 3. Multimedia y Assets Binarios Pesados
# ----------------------------------------------------
public/img/
public/nuevas/
public/icons/
public/*.gif
public/*.jpg
public/*.jpeg
public/*.png
public/*.webp
public/*.svg
public/*.ico
*.mp4
*.mp3
*.wav
*.pdf

# ----------------------------------------------------
# 4. Volcados y Semillas de Datos Masivos de Base de Datos
# (Grandes listas JSON que agotan la ventana de contexto de IA)
# ----------------------------------------------------
prisma/datosactuales/
prisma/export/
prisma/importar/
prisma/*.json
*.sql
*.sqlite
*.sqlite3
*.dump
*.csv
*.tsv
*.xlsx

# ----------------------------------------------------
# 5. Registros, Métricas y Depuración
# ----------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*
coverage/
.nyc_output/

# ----------------------------------------------------
# 6. Secretos y Entornos Locales
# ----------------------------------------------------
.env
.env*.local
.env.development
.env.production
.env.test
*.pem
*.key
*.cert

# ----------------------------------------------------
# 7. Librerías de Skills de Terceros (NO son código del proyecto)
# ----------------------------------------------------
# .agents/, .claude/ y .hermes/ contienen TRES COPIAS IDÉNTICAS de la misma
# librería de skills: 3 × 444 = 1.332 archivos, ~6,6 MB. Excluidas del contexto
# sin afectar al proyecto: son herramientas externas del entorno de desarrollo.
# Se excluye solo skills/ para no tapar un futuro .claude/settings.json del repo.
.agents/skills/
.claude/skills/
.hermes/skills/
skills-lock.json

# ----------------------------------------------------
# 8. Control de Versiones y Metadatos de IDE
# ----------------------------------------------------
.git/
.svn/
.hg/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
.modified
